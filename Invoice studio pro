<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Invoice Studio — offline invoices, quotes and receipts</title>
<meta name="description" content="Create invoices, quotes and receipts offline. No account, no subscription, no data leaves your computer. 150+ currencies, crypto payment details, 7 document languages.">
<style>
/* ============================================================
   Invoice Studio v1.0
   A single-file, offline invoicing desk.
   Everything below is yours to edit. No build step, no bundler.
   ============================================================ */

:root{
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --paper:#FBFAF6;
  --ink:#1A1C23;
  --ink-soft:#585C69;
  --ink-faint:#8D91A0;
  --rule:#DFDACE;
  --rule-soft:#EDE9E0;
  --desk:#63666E;
  --desk-dark:#4B4E55;
  --accent:#2B4C9B;
  --accent-soft:#E8EDF8;
  --stamp:#B3341F;
  --ok:#2F6B4F;
  --field:#FFFFFF;
  --shadow:0 1px 2px rgba(26,28,35,.06), 0 8px 24px rgba(26,28,35,.10);
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family:var(--sans);
  font-size:14px;
  line-height:1.5;
  color:var(--ink);
  background:var(--desk);
  -webkit-font-smoothing:antialiased;
}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}

/* ---------- top bar ---------- */
.bar{
  height:52px;
  background:var(--ink);
  color:#F3F1EC;
  display:flex;
  align-items:center;
  gap:14px;
  padding:0 14px;
  position:sticky;
  top:0;
  z-index:40;
}
.brand{display:flex;align-items:center;gap:9px;font-weight:600;letter-spacing:-.01em;white-space:nowrap}
.brand .mark{
  width:22px;height:22px;border-radius:3px;background:var(--paper);
  display:grid;place-items:center;color:var(--ink);font-size:13px;font-weight:700;
  font-family:var(--serif);
}
.brand small{font-weight:400;color:#9A9DA8;font-size:11px;margin-left:2px}

.seg{display:flex;background:rgba(255,255,255,.08);border-radius:6px;padding:2px}
.seg button{
  border:0;background:transparent;color:#B9BCC6;padding:5px 12px;border-radius:4px;
  font-size:13px;
}
.seg button[aria-pressed="true"]{background:var(--paper);color:var(--ink);font-weight:600}
.bar .spacer{flex:1}

.tbtn{
  border:1px solid rgba(255,255,255,.18);background:transparent;color:#E8E6E1;
  padding:6px 11px;border-radius:6px;font-size:13px;white-space:nowrap;
}
.tbtn:hover{background:rgba(255,255,255,.1)}
.tbtn.solid{background:var(--paper);color:var(--ink);border-color:var(--paper);font-weight:600}
.tbtn.solid:hover{background:#fff}

/* ---------- workspace ---------- */
.workspace{display:flex;height:calc(100% - 52px);overflow:hidden}

.panel{
  width:392px;flex:none;background:var(--paper);overflow-y:auto;
  border-right:1px solid rgba(0,0,0,.2);
}
.stage{
  flex:1;overflow-y:auto;padding:26px 20px 80px;
  background:
    radial-gradient(1200px 500px at 50% -120px, rgba(255,255,255,.07), transparent 70%),
    var(--desk);
}

/* ---------- panel internals ---------- */
details.sec{border-bottom:1px solid var(--rule-soft)}
details.sec > summary{
  list-style:none;cursor:pointer;padding:13px 16px;display:flex;align-items:center;gap:8px;
  font-weight:600;font-size:13.5px;user-select:none;
}
details.sec > summary::-webkit-details-marker{display:none}
details.sec > summary::before{
  content:"";width:6px;height:6px;border-right:1.5px solid var(--ink-faint);
  border-bottom:1.5px solid var(--ink-faint);transform:rotate(-45deg);
  transition:transform .15s ease;flex:none;margin-right:2px;
}
details.sec[open] > summary::before{transform:rotate(45deg)}
details.sec > summary:hover{background:#F4F1EA}
details.sec .body{padding:2px 16px 18px}
summary .hint{margin-left:auto;font-weight:400;font-size:11.5px;color:var(--ink-faint)}

label.f{display:block;margin:0 0 11px}
label.f > span{display:block;font-size:12px;color:var(--ink-soft);margin-bottom:4px}
.in{
  width:100%;background:var(--field);border:1px solid var(--rule);border-radius:5px;
  padding:7px 9px;font-size:13.5px;
}
.in:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:var(--accent)}
textarea.in{resize:vertical;min-height:62px;line-height:1.45}
.row{display:flex;gap:9px}
.row > *{flex:1;min-width:0}

.mini{
  border:1px solid var(--rule);background:#fff;border-radius:5px;padding:6px 10px;font-size:12.5px;
}
.mini:hover{background:#F4F1EA}
.mini.danger{color:var(--stamp);border-color:#E7C9C2}
.mini.danger:hover{background:#FBEFEC}

/* items editor */
.item{
  border:1px solid var(--rule);border-radius:6px;background:#fff;padding:9px;margin-bottom:8px;
}
.item .top{display:flex;gap:8px;align-items:flex-start}
.item .top textarea{min-height:40px}
.item .grab{
  flex:none;width:20px;height:20px;border:0;background:transparent;color:var(--ink-faint);
  cursor:grab;font-size:13px;line-height:1;padding:0;margin-top:5px;
}
.item .x{
  flex:none;border:0;background:transparent;color:var(--ink-faint);font-size:17px;line-height:1;
  padding:2px 4px;margin-top:2px;border-radius:4px;
}
.item .x:hover{color:var(--stamp);background:#FBEFEC}
.item .nums{display:flex;gap:7px;margin-top:7px;align-items:flex-end}
.item .nums label{margin:0}
.item .lineamt{
  margin-left:auto;font-variant-numeric:tabular-nums;font-size:13px;color:var(--ink-soft);
  padding-bottom:7px;white-space:nowrap;
}
.item.dragging{opacity:.4}
.item.over{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}

.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.chip{
  border:1px solid var(--rule);background:#fff;border-radius:20px;padding:4px 11px;font-size:12.5px;
}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}

.swatches{display:flex;gap:7px;flex-wrap:wrap}
.sw{width:26px;height:26px;border-radius:50%;border:2px solid transparent;padding:0;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.sw[aria-pressed="true"]{border-color:var(--ink)}

.logo-drop{
  border:1px dashed var(--rule);border-radius:6px;padding:12px;text-align:center;
  background:#fff;color:var(--ink-faint);font-size:12.5px;
}
.logo-drop img{max-height:44px;max-width:150px;display:block;margin:0 auto 7px}

.note{font-size:11.5px;color:var(--ink-faint);line-height:1.45;margin:6px 0 0}

/* ---------- the sheet ---------- */
.sheet-wrap{max-width:210mm;margin:0 auto}
.sheet{
  width:100%;min-height:297mm;background:#fff;color:#111;
  box-shadow:0 2px 4px rgba(0,0,0,.2), 0 18px 50px rgba(0,0,0,.28);
  padding:18mm 16mm;position:relative;overflow:hidden;
}
.sheet[data-tpl="classic"]{font-family:var(--serif);font-size:11.2pt;line-height:1.5}
.sheet[data-tpl="modern"]{font-family:var(--sans);font-size:10.6pt;line-height:1.55}
.sheet[data-tpl="compact"]{font-family:var(--sans);font-size:9.8pt;line-height:1.42;padding:14mm 13mm}
.sheet[data-tpl="typed"]{font-family:var(--mono);font-size:9.6pt;line-height:1.55}
.sheet[dir="rtl"]{font-family:"Vazirmatn",Tahoma,"Segoe UI",sans-serif}

.doc-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start}
.doc-title{
  margin:0;font-size:1.9em;letter-spacing:-.015em;line-height:1.05;font-weight:700;
}
.sheet[data-tpl="typed"] .doc-title{letter-spacing:.14em;font-size:1.3em}
.doc-meta{margin-top:10px;font-size:.86em;color:#4A4E58}
.doc-meta div{display:flex;gap:8px;margin-bottom:2px}
.doc-meta b{font-weight:600;color:#1A1C23;min-width:78px;display:inline-block}
.doc-logo img{max-height:56px;max-width:190px;display:block}
.issuer{text-align:right;font-size:.88em;line-height:1.5}
.sheet[dir="rtl"] .issuer{text-align:left}
.issuer .nm{font-weight:700;font-size:1.12em}
.issuer .ln{color:#4A4E58}

.accent-rule{height:3px;background:var(--doc-accent,#2B4C9B);margin:14px 0 0;border-radius:2px}
.sheet[data-tpl="typed"] .accent-rule{height:1px;background:#111}

.parties{display:flex;gap:26px;margin:20px 0 4px}
.party{flex:1;min-width:0}
.party h4{
  margin:0 0 5px;font-size:.72em;font-weight:700;letter-spacing:.06em;
  color:var(--doc-accent,#2B4C9B);text-transform:uppercase;
}
.sheet[data-tpl="typed"] .party h4{color:#111}
.party .nm{font-weight:700}
.party .ln{color:#4A4E58;font-size:.92em;white-space:pre-line}

table.lines{width:100%;border-collapse:collapse;margin:20px 0 0;font-size:.94em}
table.lines th{
  text-align:left;font-size:.78em;letter-spacing:.04em;font-weight:700;color:#fff;
  background:var(--doc-accent,#2B4C9B);padding:7px 9px;text-transform:uppercase;
}
.sheet[dir="rtl"] table.lines th{text-align:right}
table.lines th.n,table.lines td.n{text-align:right;white-space:nowrap}
.sheet[dir="rtl"] table.lines th.n,.sheet[dir="rtl"] table.lines td.n{text-align:left}
table.lines td{padding:8px 9px;border-bottom:1px solid #E6E2D8;vertical-align:top}
table.lines td.n{font-variant-numeric:tabular-nums}
table.lines tr:nth-child(even) td{background:#FAF9F5}
.sheet[data-tpl="typed"] table.lines th{background:transparent;color:#111;border-bottom:1px solid #111;border-top:1px solid #111}
.sheet[data-tpl="typed"] table.lines tr:nth-child(even) td{background:transparent}
.li-desc{white-space:pre-line}

.totals{display:flex;justify-content:flex-end;margin-top:14px}
.sheet[dir="rtl"] .totals{justify-content:flex-start}
.totals table{border-collapse:collapse;min-width:52%;font-size:.94em}
.totals td{padding:5px 9px}
.totals td.k{color:#4A4E58}
.totals td.v{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.sheet[dir="rtl"] .totals td.v{text-align:left}
.totals tr.grand td{
  border-top:2px solid var(--doc-accent,#2B4C9B);font-weight:700;font-size:1.22em;padding-top:8px;
}
.totals tr.paidline td{color:var(--ok)}

.blocks{display:flex;gap:26px;margin-top:26px;font-size:.88em}
.block{flex:1;min-width:0}
.block h4{
  margin:0 0 5px;font-size:.78em;font-weight:700;letter-spacing:.05em;
  color:var(--doc-accent,#2B4C9B);text-transform:uppercase;
}
.sheet[data-tpl="typed"] .block h4{color:#111}
.block p{margin:0;white-space:pre-line;color:#3C4048;line-height:1.5}
.crypto-row{display:flex;gap:8px;align-items:baseline;margin-bottom:3px}
.crypto-row b{flex:none;min-width:74px;font-weight:700}
.crypto-row code{font-family:var(--mono);font-size:.86em;word-break:break-all;color:#3C4048}

.doc-foot{
  position:absolute;left:16mm;right:16mm;bottom:12mm;padding-top:8px;
  border-top:1px solid #E6E2D8;font-size:.78em;color:#7A7E88;
  display:flex;justify-content:space-between;gap:16px;
}

.stamp{
  position:absolute;top:118mm;right:22mm;
  border:3px solid var(--stamp);color:var(--stamp);
  padding:7px 20px;font-size:26px;font-weight:800;letter-spacing:.14em;
  transform:rotate(-13deg);border-radius:5px;opacity:.82;pointer-events:none;
  font-family:var(--sans);
}
.sheet[dir="rtl"] .stamp{right:auto;left:22mm;transform:rotate(13deg)}

/* ---------- drawer ---------- */
.drawer{
  position:fixed;top:0;bottom:0;right:0;width:430px;max-width:92vw;background:var(--paper);
  box-shadow:-10px 0 40px rgba(0,0,0,.3);z-index:60;display:flex;flex-direction:column;
  transform:translateX(100%);transition:transform .22s cubic-bezier(.3,.8,.4,1);
}
.drawer[data-open="true"]{transform:translateX(0)}
.drawer header{
  display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--rule);
}
.drawer header h3{margin:0;font-size:15px}
.drawer .list{flex:1;overflow-y:auto;padding:10px 16px 24px}
.scrim{position:fixed;inset:0;background:rgba(20,22,28,.45);z-index:55;display:none}
.scrim[data-open="true"]{display:block}

.doc-card{
  border:1px solid var(--rule);border-radius:6px;background:#fff;padding:10px 12px;margin-bottom:8px;
}
.doc-card .t{display:flex;gap:8px;align-items:baseline}
.doc-card .num{font-weight:600}
.doc-card .amt{margin-left:auto;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}
.doc-card .s{font-size:12px;color:var(--ink-faint);margin-top:2px}
.doc-card .acts{display:flex;gap:6px;margin-top:8px}
.pill{font-size:10.5px;padding:1px 7px;border-radius:10px;border:1px solid}
.pill.draft{color:var(--ink-faint);border-color:var(--rule)}
.pill.sent{color:var(--accent);border-color:#BFCDE8;background:var(--accent-soft)}
.pill.paid{color:var(--ok);border-color:#BFD8CB;background:#EAF3EE}
.pill.overdue{color:var(--stamp);border-color:#E7C9C2;background:#FBEFEC}

.empty{text-align:center;color:var(--ink-faint);padding:44px 18px;font-size:13px;line-height:1.6}

/* toast */
.toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(14px);
  background:var(--ink);color:#F3F1EC;padding:9px 16px;border-radius:7px;font-size:13px;
  z-index:80;opacity:0;pointer-events:none;transition:opacity .18s,transform .18s;
}
.toast[data-show="true"]{opacity:1;transform:translateX(-50%) translateY(0)}

/* mobile */
.mobile-tabs{display:none}
@media (max-width:900px){
  .workspace{display:block;height:calc(100% - 52px);overflow-y:auto}
  .panel{width:100%;border-right:0;overflow:visible}
  .stage{padding:14px 10px 70px}
  .sheet{padding:12mm 10mm;min-height:0}
  body[data-view="preview"] .panel{display:none}
  body[data-view="edit"] .stage{display:none}
  .mobile-tabs{display:flex}
  .brand small{display:none}
  .bar .seg:not(.mobile-tabs){display:none}
}

@media (prefers-reduced-motion:reduce){
  *{transition:none !important;animation:none !important}
}

/* ---------- print ---------- */
@page{size:A4;margin:0}
@media print{
  body{background:#fff}
  .bar,.panel,.drawer,.scrim,.toast{display:none !important}
  .workspace{display:block;height:auto;overflow:visible}
  .stage{padding:0;background:#fff;overflow:visible}
  .sheet-wrap{max-width:none}
  .sheet{box-shadow:none;width:210mm;min-height:297mm;margin:0 auto}
  .doc-foot{position:fixed}
}
</style>
</head>
<body data-view="edit">

<div class="bar">
  <div class="brand"><span class="mark">IS</span>Invoice Studio <small>v1.0</small></div>

  <div class="seg" role="group" aria-label="Document type">
    <button data-doctype="invoice" aria-pressed="true">Invoice</button>
    <button data-doctype="quote" aria-pressed="false">Quote</button>
    <button data-doctype="receipt" aria-pressed="false">Receipt</button>
  </div>

  <div class="spacer"></div>

  <div class="seg mobile-tabs" role="group" aria-label="View">
    <button data-view="edit" aria-pressed="true">Edit</button>
    <button data-view="preview" aria-pressed="false">Preview</button>
  </div>

  <button class="tbtn" id="btn-new">New</button>
  <button class="tbtn" id="btn-open">Saved</button>
  <button class="tbtn" id="btn-save">Save</button>
  <button class="tbtn solid" id="btn-print">Print / PDF</button>
</div>

<div class="workspace">
  <aside class="panel">

    <details class="sec" open>
      <summary>Document <span class="hint" id="hint-doc"></span></summary>
      <div class="body">
        <div class="row">
          <label class="f"><span>Type</span>
            <select class="in" data-bind="meta.docType">
              <option value="invoice">Invoice</option>
              <option value="quote">Quote</option>
              <option value="receipt">Receipt</option>
            </select>
          </label>
          <label class="f"><span>Number</span><input class="in" data-bind="meta.number"></label>
          <label class="f"><span>Status</span>
            <select class="in" data-bind="meta.status">
              <option value="draft">Draft</option>
              <option value="sent">Sent</option>
              <option value="paid">Paid</option>
              <option value="overdue">Overdue</option>
            </select>
          </label>
        </div>
        <div class="row">
          <label class="f"><span>Issue date</span><input type="date" class="in" data-bind="meta.issueDate"></label>
          <label class="f"><span>Due date</span><input type="date" class="in" data-bind="meta.dueDate"></label>
        </div>
        <div class="row">
          <label class="f"><span>Reference / PO</span><input class="in" data-bind="meta.reference" placeholder="optional"></label>
          <label class="f"><span>Currency</span><select class="in" id="sel-currency" data-bind="meta.currency"></select></label>
        </div>
        <label class="f"><span>Document language</span>
          <select class="in" id="sel-lang" data-bind="meta.lang"></select>
        </label>
        <p class="note">Labels on the document switch language. Your own text stays exactly as you typed it.</p>
      </div>
    </details>

    <details class="sec">
      <summary>Your business <span class="hint">saved for next time</span></summary>
      <div class="body">
        <div class="logo-drop" id="logo-drop">
          <div id="logo-preview"></div>
          <button class="mini" id="btn-logo">Add logo</button>
          <button class="mini danger" id="btn-logo-clear" hidden>Remove</button>
          <input type="file" id="logo-input" accept="image/*" hidden>
          <p class="note">PNG or SVG, stored on this device only.</p>
        </div>
        <label class="f"><span>Business name</span><input class="in" data-bind="from.name"></label>
        <label class="f"><span>Address</span><textarea class="in" data-bind="from.address"></textarea></label>
        <div class="row">
          <label class="f"><span>Email</span><input class="in" data-bind="from.email"></label>
          <label class="f"><span>Phone</span><input class="in" data-bind="from.phone"></label>
        </div>
        <div class="row">
          <label class="f"><span>Website</span><input class="in" data-bind="from.website"></label>
          <label class="f"><span>Tax / VAT number</span><input class="in" data-bind="from.taxId"></label>
        </div>
      </div>
    </details>

    <details class="sec" open>
      <summary>Client <span class="hint" id="hint-clients"></span></summary>
      <div class="body">
        <div class="chips" id="client-chips"></div>
        <label class="f"><span>Client name</span><input class="in" data-bind="to.name"></label>
        <label class="f"><span>Address</span><textarea class="in" data-bind="to.address"></textarea></label>
        <div class="row">
          <label class="f"><span>Email</span><input class="in" data-bind="to.email"></label>
          <label class="f"><span>Tax / VAT number</span><input class="in" data-bind="to.taxId"></label>
        </div>
        <button class="mini" id="btn-save-client">Save this client</button>
      </div>
    </details>

    <details class="sec" open>
      <summary>Line items <span class="hint" id="hint-items"></span></summary>
      <div class="body">
        <div id="items"></div>
        <button class="mini" id="btn-add-item">Add line</button>
        <p class="note">Drag the handle to reorder. Rate can be negative for a credit line.</p>
      </div>
    </details>

    <details class="sec">
      <summary>Tax, discount &amp; shipping</summary>
      <div class="body">
        <label class="f"><span>Tax applies</span>
          <select class="in" data-bind="calc.taxMode">
            <option value="none">No tax</option>
            <option value="single">One rate on everything</option>
            <option value="perItem">Per line item</option>
          </select>
        </label>
        <div class="row">
          <label class="f"><span>Tax label</span><input class="in" data-bind="calc.taxLabel" placeholder="VAT"></label>
          <label class="f"><span>Rate %</span><input type="number" step="0.01" class="in" data-bind="calc.taxRate"></label>
        </div>
        <label class="f"><span>Tax is included in prices</span>
          <select class="in" data-bind="calc.taxInclusive">
            <option value="no">No — add on top</option>
            <option value="yes">Yes — prices already include it</option>
          </select>
        </label>
        <div class="row">
          <label class="f"><span>Discount</span>
            <select class="in" data-bind="calc.discountType">
              <option value="percent">Percent</option>
              <option value="fixed">Fixed amount</option>
            </select>
          </label>
          <label class="f"><span>Value</span><input type="number" step="0.01" class="in" data-bind="calc.discountValue"></label>
        </div>
        <div class="row">
          <label class="f"><span>Shipping / fees</span><input type="number" step="0.01" class="in" data-bind="calc.shipping"></label>
          <label class="f"><span>Amount already paid</span><input type="number" step="0.01" class="in" data-bind="calc.paid"></label>
        </div>
      </div>
    </details>

    <details class="sec">
      <summary>Payment details</summary>
      <div class="body">
        <label class="f"><span>Bank / transfer instructions</span>
          <textarea class="in" data-bind="pay.bank" placeholder="Bank name&#10;IBAN&#10;SWIFT / BIC"></textarea>
        </label>
        <label class="f"><span>Crypto wallets</span></label>
        <div id="wallets"></div>
        <button class="mini" id="btn-add-wallet">Add wallet</button>
        <p class="note">Wallet addresses print as selectable text so the client can copy them from a PDF.</p>
      </div>
    </details>

    <details class="sec">
      <summary>Notes &amp; terms</summary>
      <div class="body">
        <label class="f"><span>Notes to the client</span><textarea class="in" data-bind="notes"></textarea></label>
        <label class="f"><span>Terms</span><textarea class="in" data-bind="terms"></textarea></label>
        <label class="f"><span>Footer line</span><input class="in" data-bind="footer"></label>
      </div>
