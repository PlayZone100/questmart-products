    <details class="sec">
      <summary>Appearance</summary>
      <div class="body">
        <label class="f"><span>Template</span></label>
        <div class="chips" id="tpl-chips">
          <button class="chip" data-tpl="classic">Classic</button>
          <button class="chip" data-tpl="modern">Modern</button>
          <button class="chip" data-tpl="compact">Compact</button>
          <button class="chip" data-tpl="typed">Typed</button>
        </div>
        <label class="f"><span>Accent colour</span></label>
        <div class="swatches" id="swatches"></div>
        <label class="f" style="margin-top:12px"><span>Show paid stamp when status is Paid</span>
          <select class="in" data-bind="style.stamp"><option value="yes">Yes</option><option value="no">No</option></select>
        </label>
      </div>
    </details>

    <details class="sec">
      <summary>Backup</summary>
      <div class="body">
        <p class="note" style="margin-top:0">Everything lives in this browser. Export a backup file before clearing your browser data or moving to another computer.</p>
        <div class="row" style="margin-top:10px">
          <button class="mini" id="btn-export">Export backup</button>
          <button class="mini" id="btn-import">Import backup</button>
        </div>
        <div class="row" style="margin-top:8px">
          <button class="mini" id="btn-csv">Export documents as CSV</button>
        </div>
        <input type="file" id="import-input" accept="application/json" hidden>
      </div>
    </details>

  </aside>

  <section class="stage">
    <div class="sheet-wrap">
      <div class="sheet" id="sheet" data-tpl="classic"></div>
    </div>
  </section>
</div>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-label="Saved documents">
  <header>
    <h3>Saved documents</h3>
    <div class="spacer" style="flex:1"></div>
    <button class="mini" id="btn-close-drawer">Close</button>
  </header>
  <div class="list" id="doc-list"></div>
</aside>

<div class="toast" id="toast"></div>

<script>
"use strict";
/* ============================================================
   1. Reference data
   ============================================================ */

const CURRENCIES = [
  ["USD","$"],["EUR","€"],["GBP","£"],["JPY","¥"],["CNY","¥"],["INR","₹"],["AUD","A$"],
  ["CAD","C$"],["CHF","CHF"],["SEK","kr"],["NOK","kr"],["DKK","kr"],["PLN","zł"],["CZK","Kč"],
  ["HUF","Ft"],["RON","lei"],["TRY","₺"],["RUB","₽"],["UAH","₴"],["AED","AED"],["SAR","SAR"],
  ["QAR","QAR"],["KWD","KWD"],["BHD","BHD"],["OMR","OMR"],["ILS","₪"],["EGP","EGP"],["ZAR","R"],
  ["NGN","₦"],["KES","KSh"],["GHS","₵"],["MAD","MAD"],["TND","TND"],["BRL","R$"],["MXN","MX$"],
  ["ARS","AR$"],["CLP","CLP"],["COP","COP"],["PEN","S/"],["UYU","$U"],["SGD","S$"],["HKD","HK$"],
  ["TWD","NT$"],["KRW","₩"],["THB","฿"],["MYR","RM"],["IDR","Rp"],["PHP","₱"],["VND","₫"],
  ["PKR","₨"],["BDT","৳"],["LKR","Rs"],["NPR","Rs"],["NZD","NZ$"],["IRR","IRR"],["IQD","IQD"],
  ["AZN","₼"],["KZT","₸"],["GEL","₾"],["RSD","RSD"],["BGN","лв"],["HRK","kn"],["ISK","kr"],
  ["BTC","₿"],["ETH","Ξ"],["USDT","USDT"],["USDC","USDC"],["SOL","SOL"],["XMR","XMR"]
];
const CRYPTO = new Set(["BTC","ETH","USDT","USDC","SOL","XMR"]);

const LANGS = {
  en:{n:"English",rtl:false,t:{invoice:"Invoice",quote:"Quote",receipt:"Receipt",billTo:"Bill to",from:"From",number:"Number",issued:"Issued",due:"Due",ref:"Reference",desc:"Description",qty:"Qty",rate:"Rate",tax:"Tax",amount:"Amount",subtotal:"Subtotal",discount:"Discount",shipping:"Shipping",total:"Total",paid:"Paid",balance:"Amount due",notes:"Notes",terms:"Terms",payment:"Payment",paidStamp:"PAID",validUntil:"Valid until",taxId:"Tax ID"}},
  es:{n:"Español",rtl:false,t:{invoice:"Factura",quote:"Presupuesto",receipt:"Recibo",billTo:"Facturar a",from:"De",number:"Número",issued:"Emitida",due:"Vencimiento",ref:"Referencia",desc:"Descripción",qty:"Cant.",rate:"Precio",tax:"Imp.",amount:"Importe",subtotal:"Subtotal",discount:"Descuento",shipping:"Envío",total:"Total",paid:"Pagado",balance:"Importe a pagar",notes:"Notas",terms:"Condiciones",payment:"Pago",paidStamp:"PAGADO",validUntil:"Válido hasta",taxId:"NIF"}},
  fr:{n:"Français",rtl:false,t:{invoice:"Facture",quote:"Devis",receipt:"Reçu",billTo:"Facturé à",from:"De",number:"Numéro",issued:"Émise le",due:"Échéance",ref:"Référence",desc:"Description",qty:"Qté",rate:"P.U.",tax:"TVA",amount:"Montant",subtotal:"Sous-total",discount:"Remise",shipping:"Livraison",total:"Total",paid:"Payé",balance:"Montant dû",notes:"Notes",terms:"Conditions",payment:"Paiement",paidStamp:"PAYÉ",validUntil:"Valable jusqu'au",taxId:"N° TVA"}},
  de:{n:"Deutsch",rtl:false,t:{invoice:"Rechnung",quote:"Angebot",receipt:"Quittung",billTo:"Rechnung an",from:"Von",number:"Nummer",issued:"Datum",due:"Fällig",ref:"Referenz",desc:"Beschreibung",qty:"Menge",rate:"Preis",tax:"USt.",amount:"Betrag",subtotal:"Zwischensumme",discount:"Rabatt",shipping:"Versand",total:"Gesamt",paid:"Bezahlt",balance:"Zu zahlen",notes:"Anmerkungen",terms:"Bedingungen",payment:"Zahlung",paidStamp:"BEZAHLT",validUntil:"Gültig bis",taxId:"USt-IdNr."}},
  pt:{n:"Português",rtl:false,t:{invoice:"Fatura",quote:"Orçamento",receipt:"Recibo",billTo:"Faturar a",from:"De",number:"Número",issued:"Emissão",due:"Vencimento",ref:"Referência",desc:"Descrição",qty:"Qtd",rate:"Preço",tax:"Imp.",amount:"Valor",subtotal:"Subtotal",discount:"Desconto",shipping:"Envio",total:"Total",paid:"Pago",balance:"Valor a pagar",notes:"Notas",terms:"Condições",payment:"Pagamento",paidStamp:"PAGO",validUntil:"Válido até",taxId:"NIF"}},
  ar:{n:"العربية",rtl:true,t:{invoice:"فاتورة",quote:"عرض سعر",receipt:"إيصال",billTo:"إلى",from:"من",number:"الرقم",issued:"تاريخ الإصدار",due:"تاريخ الاستحقاق",ref:"المرجع",desc:"الوصف",qty:"الكمية",rate:"السعر",tax:"الضريبة",amount:"المبلغ",subtotal:"المجموع الفرعي",discount:"الخصم",shipping:"الشحن",total:"الإجمالي",paid:"المدفوع",balance:"المبلغ المستحق",notes:"ملاحظات",terms:"الشروط",payment:"الدفع",paidStamp:"مدفوعة",validUntil:"صالح حتى",taxId:"الرقم الضريبي"}},
  fa:{n:"فارسی",rtl:true,t:{invoice:"فاکتور",quote:"پیش‌فاکتور",receipt:"رسید",billTo:"صورتحساب برای",from:"از",number:"شماره",issued:"تاریخ صدور",due:"سررسید",ref:"مرجع",desc:"شرح",qty:"تعداد",rate:"قیمت واحد",tax:"مالیات",amount:"مبلغ",subtotal:"جمع جزء",discount:"تخفیف",shipping:"هزینه ارسال",total:"جمع کل",paid:"پرداخت‌شده",balance:"مبلغ قابل پرداخت",notes:"یادداشت",terms:"شرایط",payment:"پرداخت",paidStamp:"پرداخت شد",validUntil:"معتبر تا",taxId:"شناسه مالیاتی"}}
};

const ACCENTS = ["#2B4C9B","#1F6F5C","#8A3A62","#B3341F","#5B4A9E","#B0791B","#1A1C23","#2F6B8F"];

/* ============================================================
   2. Storage
   ============================================================ */

const KEY = "invoice-studio-v1";
const store = {
  read(){
    try{ return JSON.parse(localStorage.getItem(KEY)) || {}; }
    catch(e){ return {}; }
  },
  write(data){
    try{ localStorage.setItem(KEY, JSON.stringify(data)); return true; }
    catch(e){ toast("Storage is full or blocked. Export a backup to be safe."); return false; }
  }
};
let db = Object.assign({ profile:null, clients:[], docs:[], counter:1, style:null }, store.read());
const persist = () => store.write(db);

/* ============================================================
   3. State
   ============================================================ */

const today = () => new Date().toISOString().slice(0,10);
const addDays = (iso,n) => { const d=new Date(iso); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); };
const uid = () => Math.random().toString(36).slice(2,9);

function blankState(){
  const year = new Date().getFullYear();
  const num = String(db.counter).padStart(4,"0");
  return {
    id:uid(),
    meta:{docType:"invoice",number:`INV-${year}-${num}`,issueDate:today(),dueDate:addDays(today(),14),
          reference:"",status:"draft",currency:"USD",lang:"en"},
    from:Object.assign({name:"",address:"",email:"",phone:"",website:"",taxId:"",logo:""}, db.profile||{}),
    to:{name:"",address:"",email:"",taxId:""},
    items:[{id:uid(),desc:"",qty:1,rate:0,tax:0}],
    calc:{taxMode:"none",taxLabel:"VAT",taxRate:0,taxInclusive:"no",discountType:"percent",discountValue:0,shipping:0,paid:0},
    pay:{bank:"",wallets:[]},
    notes:"",terms:"",footer:"",
    style:Object.assign({tpl:"classic",accent:"#2B4C9B",stamp:"yes"}, db.style||{})
  };
}
let S = blankState();
let dirty = false;

const get = path => path.split(".").reduce((o,k)=> (o==null?o:o[k]), S);
const set = (path,val) => {
  const keys = path.split("."), last = keys.pop();
  keys.reduce((o,k)=>o[k], S)[last] = val;
};

/* ============================================================
   4. Money
   ============================================================ */

function money(n, code){
  code = code || S.meta.currency;
  const v = Number(n)||0;
  if(CRYPTO.has(code)){
    const dp = (code==="BTC"||code==="ETH"||code==="XMR") ? 8 : 2;
    return `${v.toFixed(dp).replace(/(\.\d*?[1-9])0+$/,"$1").replace(/\.0+$/,"")} ${code}`;
  }
  try{
    return new Intl.NumberFormat(undefined,{style:"currency",currency:code}).format(v);
  }catch(e){
    const sym = (CURRENCIES.find(c=>c[0]===code)||[])[1] || code;
    return `${sym}${v.toFixed(2)}`;
  }
}
const num = v => { const n = parseFloat(v); return isFinite(n) ? n : 0; };

function totals(){
  const c = S.calc;
  let sub = 0, taxBase = 0;
  const lines = S.items.map(it=>{
    const amt = num(it.qty) * num(it.rate);
    sub += amt;
    return {...it, amount:amt};
  });

  let discount = 0;
  if(num(c.discountValue) > 0){
    discount = c.discountType === "percent" ? sub * num(c.discountValue)/100 : num(c.discountValue);
  }
  const afterDiscount = sub - discount;
  const ratio = sub !== 0 ? afterDiscount/sub : 1;

  let tax = 0;
  if(c.taxMode === "single"){
    taxBase = afterDiscount;
    tax = c.taxInclusive === "yes"
      ? taxBase - taxBase/(1+num(c.taxRate)/100)
      : taxBase * num(c.taxRate)/100;
  } else if(c.taxMode === "perItem"){
    lines.forEach(l=>{
      const base = l.amount * ratio;
      tax += c.taxInclusive === "yes"
        ? base - base/(1+num(l.tax)/100)
        : base * num(l.tax)/100;
    });
  }

  const shipping = num(c.shipping);
  const total = c.taxInclusive === "yes"
    ? afterDiscount + shipping
    : afterDiscount + tax + shipping;
  const paid = num(c.paid);
  return {lines, sub, discount, tax, shipping, total, paid, balance: total - paid};
}

/* ============================================================
   5. Rendering the document
   ============================================================ */

const esc = s => String(s==null?"":s).replace(/[&<>"]/g, m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
const sheet = document.getElementById("sheet");

function fmtDate(iso, lang){
  if(!iso) return "";
  try{
    const loc = lang === "fa" ? "fa-IR" : lang;
    return new Date(iso+"T00:00:00").toLocaleDateString(loc,{year:"numeric",month:"short",day:"numeric"});
  }catch(e){ return iso; }
}

function render(){
  const L = LANGS[S.meta.lang] || LANGS.en;
  const t = L.t;
  const T = totals();
  const isQuote = S.meta.docType === "quote";
  const title = t[S.meta.docType] || t.invoice;

  sheet.setAttribute("dir", L.rtl ? "rtl" : "ltr");
  sheet.setAttribute("data-tpl", S.style.tpl);
  sheet.style.setProperty("--doc-accent", S.style.accent);

  const metaRows = [
    [t.number, S.meta.number],
    [t.issued, fmtDate(S.meta.issueDate, S.meta.lang)],
    [isQuote ? t.validUntil : t.due, fmtDate(S.meta.dueDate, S.meta.lang)],
    [t.ref, S.meta.reference]
  ].filter(r=>r[1]);

  const issuerLines = [S.from.address, S.from.email, S.from.phone, S.from.website,
    S.from.taxId ? `${t.taxId}: ${S.from.taxId}` : ""].filter(Boolean);
  const clientLines = [S.to.address, S.to.email,
    S.to.taxId ? `${t.taxId}: ${S.to.taxId}` : ""].filter(Boolean);

  const perItemTax = S.calc.taxMode === "perItem";

  const rows = T.lines.map(l=>`
    <tr>
      <td><div class="li-desc">${esc(l.desc) || "&nbsp;"}</div></td>
      <td class="n">${esc(l.qty)}</td>
      <td class="n">${money(l.rate)}</td>
      ${perItemTax ? `<td class="n">${num(l.tax)}%</td>` : ""}
      <td class="n">${money(l.amount)}</td>
    </tr>`).join("");

  const totalRows = [];
  if(T.discount || T.tax || T.shipping || T.paid){
    totalRows.push(`<tr><td class="k">${t.subtotal}</td><td class="v">${money(T.sub)}</td></tr>`);
  }
  if(T.discount) totalRows.push(`<tr><td class="k">${t.discount}</td><td class="v">−${money(T.discount)}</td></tr>`);
  if(T.tax){
    const label = (S.calc.taxLabel || t.tax) + (S.calc.taxMode==="single" ? ` ${num(S.calc.taxRate)}%` : "")
      + (S.calc.taxInclusive==="yes" ? " (incl.)" : "");
    totalRows.push(`<tr><td class="k">${esc(label)}</td><td class="v">${money(T.tax)}</td></tr>`);
  }
  if(T.shipping) totalRows.push(`<tr><td class="k">${t.shipping}</td><td class="v">${money(T.shipping)}</td></tr>`);
  totalRows.push(`<tr class="grand"><td class="k">${t.total}</td><td class="v">${money(T.total)}</td></tr>`);
  if(T.paid){
    totalRows.push(`<tr class="paidline"><td class="k">${t.paid}</td><td class="v">−${money(T.paid)}</td></tr>`);
    totalRows.push(`<tr class="grand"><td class="k">${t.balance}</td><td class="v">${money(T.balance)}</td></tr>`);
  }

  const walletHTML = (S.pay.wallets||[]).filter(w=>w.address).map(w=>
    `<div class="crypto-row"><b>${esc(w.coin||"Wallet")}</b><code>${esc(w.address)}</code></div>`).join("");
  const payHTML = [S.pay.bank ? `<p>${esc(S.pay.bank)}</p>` : "", walletHTML].filter(Boolean).join("");

  const blocks = [
    S.notes ? `<div class="block"><h4>${t.notes}</h4><p>${esc(S.notes)}</p></div>` : "",
    S.terms ? `<div class="block"><h4>${t.terms}</h4><p>${esc(S.terms)}</p></div>` : "",
    payHTML ? `<div class="block"><h4>${t.payment}</h4>${payHTML}</div>` : ""
  ].filter(Boolean).join("");

  sheet.innerHTML = `
    <div class="doc-head">
      <div>
        ${S.from.logo ? `<div class="doc-logo"><img src="${S.from.logo}" alt=""></div>` : ""}
        <h1 class="doc-title" style="margin-top:${S.from.logo?"12px":"0"}">${title}</h1>
        <div class="doc-meta">
          ${metaRows.map(r=>`<div><b>${r[0]}</b><span>${esc(r[1])}</span></div>`).join("")}
        </div>
      </div>
      <div class="issuer">
        <div class="nm">${esc(S.from.name)}</div>
        ${issuerLines.map(l=>`<div class="ln">${esc(l).replace(/\n/g,"<br>")}</div>`).join("")}
      </div>
    </div>
    <div class="accent-rule"></div>

    <div class="parties">
      <div class="party">
        <h4>${t.billTo}</h4>
        <div class="nm">${esc(S.to.name) || "—"}</div>
        ${clientLines.map(l=>`<div class="ln">${esc(l)}</div>`).join("")}
      </div>
    </div>

    <table class="lines">
      <thead><tr>
        <th>${t.desc}</th><th class="n">${t.qty}</th><th class="n">${t.rate}</th>
        ${perItemTax ? `<th class="n">${t.tax}</th>` : ""}<th class="n">${t.amount}</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>

    <div class="totals"><table>${totalRows.join("")}</table></div>

    ${blocks ? `<div class="blocks">${blocks}</div>` : ""}

    ${(S.meta.status==="paid" && S.style.stamp==="yes") ? `<div class="stamp">${t.paidStamp}</div>` : ""}

    <div class="doc-foot">
      <span>${esc(S.footer || S.from.name)}</span>
      <span>${esc(S.meta.number)}</span>
    </div>`;

  document.getElementById("hint-doc").textContent = money(T.total);
  document.getElementById("hint-items").textContent = S.items.length + (S.items.length===1?" line":" lines");
  document.title = `${S.meta.number} — ${S.to.name || "Invoice Studio"}`;
}

/* ============================================================
   6. Panel wiring
   ============================================================ */

function fillSelects(){
  const cur = document.getElementById("sel-currency");
  cur.innerHTML = CURRENCIES.map(([c,s])=>
    `<option value="${c}">${c}${CRYPTO.has(c)?" — crypto":` — ${s}`}</option>`).join("");
  const lang = document.getElementById("sel-lang");
  lang.innerHTML = Object.entries(LANGS).map(([k,v])=>`<option value="${k}">${v.n}</option>`).join("");
  document.getElementById("swatches").innerHTML = ACCENTS.map(c=>
    `<button class="sw" data-accent="${c}" style="background:${c}" aria-label="${c}"></button>`).join("");
}

function syncInputs(){
  document.querySelectorAll("[data-bind]").forEach(el=>{
    const v = get(el.dataset.bind);
    el.value = v == null ? "" : v;
  });
  document.querySelectorAll("#tpl-chips .chip").forEach(b=>
    b.setAttribute("aria-pressed", String(b.dataset.tpl === S.style.tpl)));
  document.querySelectorAll("#swatches .sw").forEach(b=>
    b.setAttribute("aria-pressed", String(b.dataset.accent === S.style.accent)));
  document.querySelectorAll(".seg [data-doctype]").forEach(b=>
    b.setAttribute("aria-pressed", String(b.dataset.doctype === S.meta.docType)));
  renderLogo();
}

document.addEventListener("input", e=>{
  const el = e.target.closest("[data-bind]");
  if(!el) return;
  const path = el.dataset.bind;
  const isNum = el.type === "number";
  set(path, isNum ? (el.value === "" ? 0 : parseFloat(el.value)) : el.value);
  dirty = true;
  if(path === "meta.docType"){
    const prefix = {invoice:"INV",quote:"QTE",receipt:"RCP"}[S.meta.docType];
    S.meta.number = S.meta.number.replace(/^[A-Z]{3}/, prefix);
    syncInputs();
  }
  if(path.startsWith("from.")) saveProfile();
  if(path.startsWith("style.")) { db.style = {...S.style}; persist(); }
  render();
});

function saveProfile(){ db.profile = {...S.from}; persist(); }

/* ---- items ---- */
const itemsEl = document.getElementById("items");

function renderItems(){
  const perItemTax = S.calc.taxMode === "perItem";
  itemsEl.innerHTML = S.items.map((it,i)=>`
    <div class="item" draggable="true" data-i="${i}">
      <div class="top">
        <button class="grab" title="Drag to reorder" aria-label="Reorder line ${i+1}">⠿</button>
        <textarea class="in" data-item="desc" data-i="${i}" placeholder="What are you charging for?">${esc(it.desc)}</textarea>
        <button class="x" data-del="${i}" aria-label="Remove line ${i+1}">×</button>
      </div>
      <div class="nums">
        <label class="f" style="max-width:68px"><span>Qty</span>
          <input type="number" step="any" class="in" data-item="qty" data-i="${i}" value="${it.qty}"></label>
        <label class="f" style="max-width:98px"><span>Rate</span>
          <input type="number" step="any" class="in" data-item="rate" data-i="${i}" value="${it.rate}"></label>
        ${perItemTax ? `<label class="f" style="max-width:68px"><span>Tax %</span>
          <input type="number" step="any" class="in" data-item="tax" data-i="${i}" value="${it.tax}"></label>` : ""}
        <span class="lineamt">${money(num(it.qty)*num(it.rate))}</span>
      </div>
    </div>`).join("");
}

itemsEl.addEventListener("input", e=>{
  const el = e.target.closest("[data-item]");
  if(!el) return;
  const i = +el.dataset.i, k = el.dataset.item;
  S.items[i][k] = el.type === "number" ? (el.value===""?0:parseFloat(el.value)) : el.value;
  dirty = true;
  if(k !== "desc") renderItems();
  render();
});
itemsEl.addEventListener("click", e=>{
  const del = e.target.closest("[data-del]");
  if(!del) return;
  S.items.splice(+del.dataset.del,1);
  if(!S.items.length) S.items.push({id:uid(),desc:"",qty:1,rate:0,tax:0});
  renderItems(); render();
});
document.getElementById("btn-add-item").onclick = ()=>{
  S.items.push({id:uid(),desc:"",qty:1,rate:0,tax:0});
  renderItems(); render();
  const last = itemsEl.querySelector(".item:last-child textarea");
  if(last) last.focus();
};

/* drag to reorder */
let dragFrom = null;
itemsEl.addEventListener("dragstart", e=>{
  const row = e.target.closest(".item"); if(!row) return;
  dragFrom = +row.dataset.i; row.classList.add("dragging");
  e.dataTransfer.effectAllowed = "move";
});
itemsEl.addEventListener("dragover", e=>{
  e.preventDefault();
  const row = e.target.closest(".item"); if(!row) return;
  itemsEl.querySelectorAll(".item").forEach(r=>r.classList.remove("over"));
  row.classList.add("over");
});
itemsEl.addEventListener("drop", e=>{
  e.preventDefault();
  const row = e.target.closest(".item");
  if(row && dragFrom !== null){
    const to = +row.dataset.i;
    const [moved] = S.items.splice(dragFrom,1);
    S.items.splice(to,0,moved);
  }
  dragFrom = null; renderItems(); render();
});
itemsEl.addEventListener("dragend", ()=>{
  dragFrom = null;
  itemsEl.querySelectorAll(".item").forEach(r=>r.classList.remove("over","dragging"));
});

/* ---- wallets ---- */
const walletsEl = document.getElementById("wallets");
function renderWallets(){
  walletsEl.innerHTML = (S.pay.wallets||[]).map((w,i)=>`
    <div class="row" style="margin-bottom:8px">
      <input class="in" style="max-width:104px" data-wal="coin" data-i="${i}" value="${esc(w.coin)}" placeholder="BTC">
      <input class="in" data-wal="address" data-i="${i}" value="${esc(w.address)}" placeholder="Wallet address">
      <button class="mini danger" data-walx="${i}" style="flex:none">×</button>
    </div>`).join("");
}
walletsEl.addEventListener("input", e=>{
  const el = e.target.closest("[data-wal]"); if(!el) return;
  S.pay.wallets[+el.dataset.i][el.dataset.wal] = el.value;
  render();
});
walletsEl.addEventListener("click", e=>{
  const x = e.target.closest("[data-walx]"); if(!x) return;
  S.pay.wallets.splice(+x.dataset.walx,1); renderWallets(); render();
});
document.getElementById("btn-add-wallet").onclick = ()=>{
  S.pay.wallets = S.pay.wallets || [];
  S.pay.wallets.push({coin:"",address:""});
  renderWallets();
};

/* ---- logo ---- */
function renderLogo(){
  const prev = document.getElementById("logo-preview");
  const clear = document.getElementById("btn-logo-clear");
  prev.innerHTML = S.from.logo ? `<img src="${S.from.logo}" alt="Your logo">` : "";
  clear.hidden = !S.from.logo;
}
document.getElementById("btn-logo").onclick = ()=> document.getElementById("logo-input").click();
document.getElementById("logo-input").onchange = e=>{
  const f = e.target.files[0]; if(!f) return;
  if(f.size > 900*1024){ toast("Logo is over 900 KB. Use a smaller file."); return; }
  const r = new FileReader();
  r.onload = ()=>{ S.from.logo = r.result; saveProfile(); renderLogo(); render(); };
  r.readAsDataURL(f);
};
document.getElementById("btn-logo-clear").onclick = ()=>{
  S.from.logo = ""; saveProfile(); renderLogo(); render();
};

/* ---- template & accent ---- */
document.getElementById("tpl-chips").onclick = e=>{
  const b = e.target.closest("[data-tpl]"); if(!b) return;
  S.style.tpl = b.dataset.tpl; db.style = {...S.style}; persist(); syncInputs(); render();
};
document.getElementById("swatches").onclick = e=>{
  const b = e.target.closest("[data-accent]"); if(!b) return;
  S.style.accent = b.dataset.accent; db.style = {...S.style}; persist(); syncInputs(); render();
};

/* ---- doc type & mobile view ---- */
document.querySelector(".bar .seg").onclick = e=>{
  const b = e.target.closest("[data-doctype]"); if(!b) return;
  S.meta.docType = b.dataset.doctype;
  const prefix = {invoice:"INV",quote:"QTE",receipt:"RCP"}[S.meta.docType];
  S.meta.number = S.meta.number.replace(/^[A-Z]{3}/, prefix);
  syncInputs(); render();
};
document.querySelector(".mobile-tabs").onclick = e=>{
  const b = e.target.closest("[data-view]"); if(!b) return;
  document.body.dataset.view = b.dataset.view;
  document.querySelectorAll(".mobile-tabs button").forEach(x=>
    x.setAttribute("aria-pressed", String(x === b)));
};

/* ---- clients ---- */
function renderClients(){
  const el = document.getElementById("client-chips");
  el.innerHTML = (db.clients||[]).map((c,i)=>
    `<button class="chip" data-client="${i}">${esc(c.name||"Unnamed")}</button>`).join("");
  document.getElementById("hint-clients").textContent =
    db.clients.length ? db.clients.length + " saved" : "";
}
document.getElementById("client-chips").onclick = e=>{
  const b = e.target.closest("[data-client]"); if(!b) return;
  S.to = {...db.clients[+b.dataset.client]};
  syncInputs(); render(); toast("Client filled in");
};
document.getElementById("btn-save-client").onclick = ()=>{
  if(!S.to.name){ toast("Add a client name first"); return; }
  const i = db.clients.findIndex(c=>c.name === S.to.name);
  if(i >= 0) db.clients[i] = {...S.to}; else db.clients.push({...S.to});
  persist(); renderClients(); toast("Client saved");
};

/* ============================================================
   7. Documents: save, open, delete
   ============================================================ */

function saveDoc(){
  const T = totals();
  const snap = JSON.parse(JSON.stringify(S));
  snap.savedAt = Date.now();
  snap.total = T.total;
  const i = db.docs.findIndex(d=>d.id === S.id);
  if(i >= 0) db.docs[i] = snap;
  else { db.docs.unshift(snap); db.counter++; }
  persist(); dirty = false; renderDocs(); toast("Saved");
}
document.getElementById("btn-save").onclick = saveDoc;

function renderDocs(){
  const el = document.getElementById("doc-list");
  if(!db.docs.length){
    el.innerHTML = `<div class="empty">Nothing saved yet.<br>Fill in a document and press Save.</div>`;
    return;
  }
  el.innerHTML = db.docs.map(d=>`
    <div class="doc-card">
      <div class="t">
        <span class="num">${esc(d.meta.number)}</span>
        <span class="pill ${d.meta.status}">${d.meta.status}</span>
        <span class="amt">${money(d.total, d.meta.currency)}</span>
      </div>
      <div class="s">${esc(d.to.name||"No client")} · ${esc(d.meta.issueDate)}</div>
      <div class="acts">
        <button class="mini" data-open="${d.id}">Open</button>
        <button class="mini" data-dup="${d.id}">Duplicate</button>
        <button class="mini danger" data-rm="${d.id}">Delete</button>
      </div>
    </div>`).join("");
}
document.getElementById("doc-list").onclick = e=>{
  const b = e.target.closest("button[data-open],button[data-dup],button[data-rm]");
  if(!b) return;
  if(b.dataset.open){
    S = JSON.parse(JSON.stringify(db.docs.find(d=>d.id === b.dataset.open)));
    dirty = false; refreshAll(); closeDrawer(); toast("Opened");
  } else if(b.dataset.dup){
    const src = db.docs.find(d=>d.id === b.dataset.dup);
    S = JSON.parse(JSON.stringify(src));
    S.id = uid();
    S.meta.number = nextNumber(S.meta.docType);
    S.meta.issueDate = today();
    S.meta.dueDate = addDays(today(),14);
    S.meta.status = "draft";
    refreshAll(); closeDrawer(); toast("Duplicated as a new draft");
  } else if(b.dataset.rm){
    const d = db.docs.find(x=>x.id === b.dataset.rm);
    if(confirm(`Delete ${d.meta.number}? This cannot be undone.`)){
      db.docs = db.docs.filter(x=>x.id !== b.dataset.rm);
      persist(); renderDocs(); toast("Deleted");
    }
  }
};
function nextNumber(type){
  const prefix = {invoice:"INV",quote:"QTE",receipt:"RCP"}[type] || "INV";
  return `${prefix}-${new Date().getFullYear()}-${String(db.counter).padStart(4,"0")}`;
}

document.getElementById("btn-new").onclick = ()=>{
  S = blankState();
  S.meta.number = nextNumber("invoice");
  dirty = false; refreshAll(); toast("New document");
};

/* drawer */
const drawer = document.getElementById("drawer"), scrim = document.getElementById("scrim");
const openDrawer = ()=>{ renderDocs(); drawer.dataset.open="true"; scrim.dataset.open="true"; };
const closeDrawer = ()=>{ drawer.dataset.open="false"; scrim.dataset.open="false"; };
document.getElementById("btn-open").onclick = openDrawer;
document.getElementById("btn-close-drawer").onclick = closeDrawer;
scrim.onclick = closeDrawer;

/* ============================================================
   8. Print, backup, CSV
   ============================================================ */

document.getElementById("btn-print").onclick = ()=>{ window.print(); };

function download(name, text, type){
  const blob = new Blob([text], {type:type||"application/json"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.appendChild(a); a.click();
  setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); }, 400);
}

document.getElementById("btn-export").onclick = ()=>{
  download(`invoice-studio-backup-${today()}.json`, JSON.stringify(db,null,2));
  toast("Backup downloaded");
};
document.getElementById("btn-import").onclick = ()=> document.getElementById("import-input").click();
document.getElementById("import-input").onchange = e=>{
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = ()=>{
    try{
      const incoming = JSON.parse(r.result);
      if(!incoming || typeof incoming !== "object") throw 0;
      const keep = confirm("Merge with what is already here? Cancel replaces everything instead.");
      if(keep){
        const ids = new Set(db.docs.map(d=>d.id));
        db.docs = db.docs.concat((incoming.docs||[]).filter(d=>!ids.has(d.id)));
        const names = new Set(db.clients.map(c=>c.name));
        db.clients = db.clients.concat((incoming.clients||[]).filter(c=>!names.has(c.name)));
        db.counter = Math.max(db.counter, incoming.counter||1);
      } else {
        db = Object.assign({profile:null,clients:[],docs:[],counter:1,style:null}, incoming);
      }
      persist(); renderClients(); renderDocs(); toast("Backup imported");
    }catch(err){ toast("That file is not an Invoice Studio backup."); }
    e.target.value = "";
  };
  r.readAsText(f);
};

document.getElementById("btn-csv").onclick = ()=>{
  if(!db.docs.length){ toast("Nothing to export yet"); return; }
  const q = v => `"${String(v==null?"":v).replace(/"/g,'""')}"`;
  const head = ["Number","Type","Status","Issue date","Due date","Client","Currency","Total"];
  const rows = db.docs.map(d=>[d.meta.number,d.meta.docType,d.meta.status,d.meta.issueDate,
    d.meta.dueDate,d.to.name,d.meta.currency,(d.total||0).toFixed(2)].map(q).join(","));
  download(`invoice-studio-${today()}.csv`, "\uFEFF"+[head.map(q).join(","), ...rows].join("\r\n"), "text/csv");
  toast("CSV downloaded");
};

/* ============================================================
   9. Misc
   ============================================================ */

let toastTimer;
function toast(msg){
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.dataset.show = "true";
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>{ el.dataset.show = "false"; }, 2200);
}

document.addEventListener("keydown", e=>{
  if((e.metaKey||e.ctrlKey) && e.key === "s"){ e.preventDefault(); saveDoc(); }
  if((e.metaKey||e.ctrlKey) && e.key === "p"){ /* let the browser print */ }
  if(e.key === "Escape") closeDrawer();
});

window.addEventListener("beforeunload", e=>{
  if(dirty){ e.preventDefault(); e.returnValue = ""; }
});

function refreshAll(){ syncInputs(); renderItems(); renderWallets(); render(); }

function firstRun(){
  if(db.docs.length || db.profile) return;
  S.from = {name:"Your business name", address:"Street\nCity, Country",
            email:"you@example.com", phone:"", website:"", taxId:"", logo:""};
  S.to = {name:"Client name", address:"Client street\nCity, Country", email:"client@example.com", taxId:""};
  S.items = [
    {id:uid(),desc:"Website design — 3 pages\nIncludes two rounds of revisions",qty:1,rate:1200,tax:0},
    {id:uid(),desc:"Copywriting",qty:4,rate:90,tax:0}
  ];
  S.calc.taxMode = "single"; S.calc.taxRate = 20; S.calc.taxLabel = "VAT";
  S.notes = "Thank you for your business.";
  S.terms = "Payment due within 14 days.";
}

fillSelects();
firstRun();
refreshAll();
renderClients();
renderDocs();
</script>
